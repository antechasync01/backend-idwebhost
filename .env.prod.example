# =============================================================
# AURA POS — Production Environment Variables
# =============================================================
# Copy this file to .env.prod and fill in ALL values.
# JANGAN commit file .env.prod ke repository!
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =============================================================

# ---- Database Configuration ----
POSTGRES_USER=aura_prod
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=aura_pos

# ---- JWT Authentication ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_USE_64_CHAR_RANDOM_STRING

# ---- LLM / AI Services ----
LLM_API_KEY=sk-your-production-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Hermes Agent ----
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HERMES_API_SERVER_KEY=CHANGE_ME_USE_HEX_KEY

# ---- Hermes Dashboard (opsional) ----
# Set true untuk mengaktifkan dashboard monitoring
HERMES_DASHBOARD_ENABLED=false
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Backend Port (exposed ke host) ----
BACKEND_PORT=8000

# ---- External APIs (opsional) ----
WEATHER_API_KEY=
EXTERNAL_EVENT_API_KEY=

# ---- Google Calendar OAuth (opsional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
